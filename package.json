{
  "name": "mineblock",
  "productName": "MineBlock",
  "version": "0.1.0",
  "description": "MineBlock \u2014 an original single-player voxel sandbox survival game.",
  "author": "MineBlock Project",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "vite build && node tools/stamp-sw.mjs",
    "build": "npm run build:renderer && electron-builder",
    "start": "npm run build:renderer && electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "build:web": "npm run build:renderer",
    "preview:web": "vite preview --port 4173",
    "deploy": "npm run build:web && wrangler pages deploy dist --project-name mineblock"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0",
    "wrangler": "^3.90.0"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "build": {
    "appId": "com.mineblock.game",
    "productName": "MineBlock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "icon": "src/public/icons/icon-512.png",
    "mac": {
      "category": "public.app-category.games",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  }
}
